# Заполните значениями из Firebase Console → настройки проекта → Ваши приложения → Web app.
# Веб-конфигурация Firebase предназначена для браузера; пароли и сервисные ключи сюда не добавляйте.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hr-potok
VITE_FIREBASE_DATABASE_URL=https://hr-potok-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
